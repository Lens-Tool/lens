# Copy to .env. Never commit real credentials.

# --- Local connector ---
# Random identifier for this project (NOT derived from paths or names). Auto-generated if empty.
LENS_PROJECT_ID=
# Opt-in: send anonymous usage statistics to the stats API (Sprint 1 task T21). Default: off.
LENS_STATS_ENABLED=false
LENS_STATS_URL=http://localhost:4000
LENS_DEBUG=false

# --- Stats API (local development) ---
PORT=4000
DATABASE_URL=postgres://lens:lens_dev_password@localhost:5432/lens
REDIS_URL=redis://localhost:6379

# --- docker-compose (local development only) ---
POSTGRES_USER=lens
POSTGRES_PASSWORD=lens_dev_password
POSTGRES_DB=lens
