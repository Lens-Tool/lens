# Copy to .env. Never commit real credentials.

# --- Local connector (read by packages/connector) ---
# Random identifier for this project (NOT derived from paths or names). Auto-generated if empty.
LENS_PROJECT_ID=
# Folder of the project. Defaults to the working directory of the connector (ADR 0003).
# LENS_PROJECT_ROOT=
# Writes each usage event (anonymous statistics only) to stderr.
LENS_DEBUG=false

# --- Statistics API and database (read by apps/stats-api) ---
PORT=4000
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# --- NOT IMPLEMENTED YET: nothing reads these. The connector does not send events anywhere. ---
# LENS_STATS_ENABLED=false
# LENS_STATS_URL=http://localhost:4000
# REDIS_URL=redis://localhost:6379   # ADR 0004 (Proposed): Redis is only started by docker compose
