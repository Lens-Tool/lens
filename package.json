{
  "name": "lens",
  "version": "0.0.0",
  "private": true,
  "description": "LENS - a task-aware, token-efficient context tool for AI coding agents",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "packages/compression",
    "packages/task-context",
    "packages/connector",
    "apps/stats-api"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "check": "npm run lint && npm run format:check && npm run build && npm run typecheck:tests && npm test",
    "dev:stats": "npm run dev -w @lens/stats-api",
    "dev:connector": "npm run dev -w @lens/connector",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
